generator client {
  provider = "prisma-client-js"
}

// Nota: Em produção (Vercel), DATABASE_URL deve apontar para PostgreSQL
// Para desenvolvimento local com SQLite, alterar para: provider = "sqlite"
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?  // NULL for OAuth-only users
  image         String?
  role          String   @default("PROFESSIONAL")
  lastLogin     DateTime?
  /// Último heartbeat (presença online no sistema)
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company?
  professional Professional?
  profile      Profile?
}

model VideoCallInvite {
  id                 String   @id @default(cuid())
  profileId          String
  companyUserId      String
  companyOwnerUserId String?
  companyName        String
  /// RINGING | ACCEPTED | DECLINED | ENDED | MISSED
  status             String   @default("RINGING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([profileId, status])
  @@index([companyUserId])
  @@index([companyOwnerUserId, profileId, status])
}

model Company {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  cnpj            String?
  responsavelNome String?
  responsavelCpf  String?
  telefone        String?
  endereco        String?
  logoUrl         String?
  fotoResponsavelUrl String?
  emailCorporativo String?
  emailCorporativoVerificado Boolean @default(false)
  cartaoCnpjUrl        String?
  verificationStatus   String   @default("PENDING")
  verifiedAt           DateTime?
  rejectionReason      String?
  planTier        String   @default("FREE")
  subscriptionExpiresAt DateTime?
  /// Usuários RH extras comprados acima do limite do plano
  extraSeats      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  favorites CompanyFavorite[]
  searchHistory CompanySearchHistory[]
  talentLists CompanyTalentList[]
  alerts CompanyAlert[]
  profileTracking CompanyProfileTracking[]
}

/// Usuários RH da mesma assinatura (dono convida; cada um tem login próprio)
model CompanyTeamMember {
  id                 String    @id @default(cuid())
  companyOwnerUserId String
  memberUserId       String?
  invitedEmail       String
  /// OWNER | ADMIN | RH | RECRUITER
  role               String    @default("RH")
  /// PENDING | ACTIVE | REVOKED
  status             String    @default("PENDING")
  inviteToken        String?   @unique
  invitedAt          DateTime  @default(now())
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyOwnerUserId, invitedEmail])
  @@index([memberUserId])
  @@index([companyOwnerUserId, status])
}

/// Perfil de profissional compartilhado entre usuários da mesma assinatura
model CompanyProfileShare {
  id                 String    @id @default(cuid())
  companyOwnerUserId String
  fromUserId         String
  toUserId           String
  profileId          String
  note               String?
  createdAt          DateTime  @default(now())
  readAt             DateTime?

  @@index([toUserId, createdAt])
  @@index([companyOwnerUserId, profileId])
}

model CompanyTalentList {
  id            String   @id @default(cuid())
  companyUserId String
  name          String
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyUserId], references: [userId], onDelete: Cascade)
  items   CompanyTalentListItem[]

  @@index([companyUserId])
}

model CompanyTalentListItem {
  id        String   @id @default(cuid())
  listId    String
  profileId String
  createdAt DateTime @default(now())

  list CompanyTalentList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, profileId])
  @@index([listId])
}

model CompanyAlert {
  id            String   @id @default(cuid())
  companyUserId String
  name          String
  filtersJSON   String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyUserId], references: [userId], onDelete: Cascade)

  @@index([companyUserId])
}

model Professional {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model CorporateEmailConfirmation {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model PaymentRecord {
  id            String   @id @default(cuid())
  reference     String   @unique
  amount        Float
  currency      String   @default("BRL")
  method        String
  customer      String?  // JSON stringified
  status        String   @default("PENDING")
  meta          String?  // JSON stringified
  externalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reference])
  @@index([status])
}

// MODELO DE VITRINE - Profissional como Produto
// Expandido para armazenar todos os dados do formulário de cadastro
model Profile {
  // Campos originais (mantidos para compatibilidade)
  id              String   @id @default(cuid())
  userId          String   @unique
  title           String   // Cargo/Profissão
  bio             String?  // Descrição resumida
  fullDescription String?  // Descrição completa
  location        String   // Cidade/Estado (formato: "Cidade, UF")
  phone           String?  // Telefone principal
  whatsapp        String?  // WhatsApp
  email           String?  // Email (cópia do User.email)
  skills          String?  // JSON stringified array ["skill1", "skill2"]
  experience      String?  // Descrição de experiência ou JSON
  portfolio       String?  // URL ou JSON
  avatar          String?  // URL da foto de perfil
  isVisible       Boolean  @default(true)
  viewCount       Int      @default(0)
  status          String   @default("ACTIVE")  // ACTIVE, INACTIVE, BLOCKED
  
  // Novos campos: Dados Pessoais
  cpf             String?  // formato: 123.456.789-00
  dataNascimento  DateTime? // Data de nascimento
  idade           Int?      // Idade calculada
  sexoBiologico   String?  // Masculino, Feminino, Outro
  identidadeGenero String?  // Cisgênero, Transgênero, Não-binário, Outro
  orientacaoSexual String? // Heterossexual, Homossexual, Bissexual, Outro
  estadoCivil     String?  // Solteiro, Casado, Divorciado, Viúvo
  religiao        String?  // Católico, Protestante, Espírita, Ateu, Outro
  antecedentes    Boolean? // Possui antecedentes criminais
  
  // Novos campos: Filhos
  possuiFilhos    Boolean? // Possui filhos
  quantidadeFilhos Int?    // Quantidade de filhos
  faixaEtariaFilhos String? // JSON array ["Menos de 1", "1-3", "3-5", etc]
  
  // Novos campos: Localização detalhada
  telefone2       String?  // Telefone secundário
  estado          String?  // UF (AC, AL, AP, AM, BA, etc)
  cidade          String?  // Município
  disponibilidadeMudanca String? // Sim, Não, Dependendo
  
  // Novos campos: Formação
  escolaridade    String?  // Fundamental, Médio, Técnico, Superior, Pós
  cursosCertificacoes String? // JSON array ["Curso 1", "Curso 2"]
  
  // Novos campos: Profissional
  situacaoProfissional String? // Empregado, Desempregado, Primeiro emprego, Jovem Aprendiz
  areaInteresse   String?  // Automotivo, Aviação, Construção, etc
  cargoDesejado   String?  // Cargo desejado
  trabalhouIndustria String? // Não, Primeiro emprego, Jovem aprendiz, Sim
  tempoExperiencia String? // <1 ano, 1-2, 3-5, 6-10, >10 anos
  experienciasJSON String? // JSON array: [{"nome": "Empresa", "cargo": "Cargo", "dataInicio": "2020-01-01", "dataFim": "2021-12-31"}]
  turnoDisponivel String?  // Manhã, Tarde, Noite, Integral
  
  // Novos campos: Recolocação e Salário
  disponibilidadeInicio String? // Imediata, 15 dias, 30 dias, 2 meses
  recolocacao     String?  // Sim, Não, Dependendo
  pretensaoSalarial String? // Faixa salarial (Até 1k, 1-2k, 2-3k, etc)
  
  // Novos campos: Documentos
  curricoURL      String?  // URL do PDF/DOC do currículo (se enviado)
  atestadoURL     String?  // URL do PDF/JPG do atestado (se enviado)
  
  // Novos campos: Mensagem
  mensagemEmpresas String? // Apresentação pessoal para empresas

  // Snapshot completo do formulário de cadastro (JSON)
  formDataJSON    String?

  // Sobre mim — preenchido apenas no dashboard (JSON)
  sobreMimJSON    String?

  // Teste comportamental — preenchido uma única vez (JSON)
  testeComportamentalJSON String?

  // Vídeo de apresentação (caminho privado no storage — não URL pública)
  videoApresentacaoPath String?
  
  // Completude do perfil (0-100) para priorização em buscas
  profileCompletion Int @default(0)
  disponivelContratacao String?

  // Plano profissional (FREE | PREMIUM)
  planTier              String    @default("FREE")
  subscriptionExpiresAt DateTime?
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileViews    ProfileView[]
  accessRecords   AccessRecord[]
  tips            Tip[]
  profileMessages ProfileMessage[]
  jobProposals    JobProposal[]

  @@index([userId])
  @@index([location])
  @@index([estado])
  @@index([status])
  @@index([createdAt])
}

// Proposta de vaga da empresa para o profissional
model JobProposal {
  id            String    @id @default(cuid())
  profileId     String
  companyUserId String
  companyName   String
  cargo         String
  salario       String
  turno         String
  cidade        String
  beneficios    String
  mensagem      String
  /// SENT | INTERESTED | MORE_INFO | DECLINED | INTERVIEW_PENDING | INTERVIEW_CONFIRMED | INTERVIEW_DECLINED
  status        String    @default("SENT")
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interview JobInterview?

  @@index([profileId])
  @@index([companyUserId])
  @@index([status])
  @@index([createdAt])
}

// Entrevista agendada a partir de uma proposta com interesse
model JobInterview {
  id            String   @id @default(cuid())
  proposalId    String   @unique
  scheduledAt   DateTime
  /// PRESENTIAL | ONLINE | PLATFORM
  locationType  String
  address       String?
  meetingUrl    String?
  observacoes   String
  /// PENDING | CONFIRMED | DECLINED | CANCELLED
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proposal JobProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
}

// Registro de quem visualizou cada profissional
model ProfileView {
  id              String   @id @default(cuid())
  profileId       String
  companyUserId   String   // ID da empresa que viu
  viewType        String   @default("SUMMARY")  // SUMMARY (sem acesso pago), FULL (com acesso pago)
  createdAt       DateTime @default(now())

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([companyUserId])
  @@index([createdAt])
}

// Acesso pago a perfil completo
model AccessRecord {
  id              String   @id @default(cuid())
  profileId       String
  companyUserId   String   // Qual empresa pagou
  accessType      String   @default("FULL")  // FULL, CONTACT_ONLY
  paymentId       String?  // ID do pagamento
  expiresAt       DateTime // Quando expira o acesso
  status          String   @default("ACTIVE")  // ACTIVE, EXPIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([companyUserId])
  @@index([status])
  @@index([expiresAt])
}

// Dicas/feedback anônimas de empresas para profissionais
model Tip {
  id              String   @id @default(cuid())
  profileId       String
  companyUserId   String   // Qual empresa deixou a dica
  message         String   // A dica/feedback
  isAnonymous     Boolean  @default(true)
  rating          Int?     // 1-5 stars opcional
  createdAt       DateTime @default(now())

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([companyUserId])
  @@index([createdAt])
}

// Mensagens de empresas para profissionais (caixa de entrada do candidato)
model ProfileMessage {
  id              String   @id @default(cuid())
  profileId       String
  companyUserId   String
  companyName     String
  body            String
  /// COMPANY = empresa → profissional | PROFESSIONAL = resposta do candidato
  senderRole      String   @default("COMPANY")
  replyToId       String?
  createdAt       DateTime @default(now())

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([companyUserId])
  @@index([createdAt])
  @@index([replyToId])
}

model CompanyFavorite {
  id            String   @id @default(cuid())
  companyUserId String
  profileId     String
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyUserId], references: [userId], onDelete: Cascade)

  @@unique([companyUserId, profileId])
  @@index([companyUserId])
}

model CompanySearchHistory {
  id            String   @id @default(cuid())
  companyUserId String
  filtersJSON   String
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyUserId], references: [userId], onDelete: Cascade)

  @@index([companyUserId])
  @@index([createdAt])
}

model CompanyProfileTracking {
  id            String   @id @default(cuid())
  companyUserId String
  profileId     String
  contatado     Boolean  @default(false)
  entrevistado  Boolean  @default(false)
  emTeste       Boolean  @default(false)
  contratado    Boolean  @default(false)
  naoContratado Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyUserId], references: [userId], onDelete: Cascade)

  @@unique([companyUserId, profileId])
  @@index([companyUserId])
  @@index([profileId])
}

/// Visitas ao site (analytics do painel admin)
model SiteVisit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

/// Auditoria de segurança (login, reset, admin, etc.)
model SecurityAuditLog {
  id        String   @id @default(cuid())
  action    String
  email     String
  ip        String
  userAgent String
  result    String
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([email])
}

// =============================================================================
// Camada de planos / assinaturas / IA / chat / notificações (scaffold)
// Tabelas novas — convivem com Company.planTier e Profile.planTier existentes
// =============================================================================

model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  audience    String   @default("COMPANY") // COMPANY | PROFESSIONAL | BOTH
  priceCents  Int      @default(0)
  currency    String   @default("BRL")
  interval    String   @default("monthly") // monthly | annual | one_time
  active      Boolean  @default(true)
  description String?
  metadata    String? // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions   PlanPermission[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanPermission {
  id        String   @id @default(cuid())
  planId    String
  key       String
  value     String   @default("true")
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
  @@map("plan_permissions")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  status                 String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | TRIALING | EXPIRED
  billingPeriod          String    @default("monthly")
  billingMode            String    @default("one_time")
  autoRenew              Boolean   @default(false)
  gatewaySubscriptionId  String?
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  metadata               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model AssistantUsage {
  id           String   @id @default(cuid())
  userId       String
  periodKey    String // YYYY-MM
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, periodKey])
  @@index([periodKey])
  @@map("assistant_usage")
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  messages  String   @default("[]") // JSON array
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  metadata  String?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

/// Preferências de canal (WhatsApp exige consentimento explícito — telefone vem de Profile/Company)
model UserNotificationPreference {
  userId             String    @id
  inAppEnabled       Boolean   @default(true)
  emailEnabled       Boolean   @default(true)
  whatsappEnabled    Boolean   @default(false)
  phoneVerified      Boolean   @default(false)
  whatsappConsent    Boolean   @default(false)
  whatsappConsentAt  DateTime?
  blocked            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("user_notification_preferences")
}

/// Outbox / log de entregas (idempotente por canal)
model NotificationDelivery {
  id                String    @id @default(cuid())
  userId            String
  event             String
  channel           String
  templateKey       String
  status            String    @default("queued")
  idempotencyKey    String    @unique
  provider          String?
  providerMessageId String?
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(5)
  lastError         String?
  errorCode         String?
  payloadSummary    String?
  recipientHint     String?
  createdAt         DateTime  @default(now())
  attemptedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

model FavoriteJob {
  id        String   @id @default(cuid())
  userId    String
  jobKey    String
  title     String?
  metadata  String?
  createdAt DateTime @default(now())

  @@unique([userId, jobKey])
  @@index([userId])
  @@map("favorite_jobs")
}

model FavoriteCandidate {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
  @@index([userId])
  @@index([profileId])
  @@map("favorite_candidates")
}

/// Visitas ao perfil do profissional (além de ProfileView legado)
model ProfileViewLog {
  id            String   @id @default(cuid())
  profileId     String
  viewerUserId  String?
  companyUserId String?
  source        String?
  createdAt     DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([viewerUserId])
  @@map("profile_views")
}

model CompanyView {
  id           String   @id @default(cuid())
  companyId    String
  viewerUserId String?
  source       String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([viewerUserId])
  @@map("company_views")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  actorType String   @default("USER")
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  ip        String?
  userAgent String?
  result    String   @default("success")
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

model ChatRoom {
  id           String   @id @default(cuid())
  type         String   @default("DIRECT") // DIRECT | GROUP | SUPPORT
  name         String?
  createdById  String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]

  @@index([type, updatedAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String    @id @default(cuid())
  roomId     String
  senderId   String
  body       String
  readAt     DateTime?
  metadata   String?
  createdAt  DateTime  @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Interview {
  id            String    @id @default(cuid())
  companyUserId String
  profileId     String
  proposalId    String?
  scheduledAt   DateTime
  status        String    @default("PENDING")
  locationType  String    @default("PLATFORM")
  address       String?
  meetingUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ratings Rating[]

  @@index([companyUserId, scheduledAt])
  @@index([profileId])
  @@index([status])
  @@map("interviews")
}

model Rating {
  id            String   @id @default(cuid())
  interviewId   String?
  companyUserId String
  profileId     String
  score         Int
  comment       String?
  createdAt     DateTime @default(now())

  interview Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([companyUserId])
  @@index([profileId])
  @@index([interviewId])
  @@map("ratings")
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  details     String?
  status      String    @default("OPEN") // OPEN | REVIEWING | RESOLVED | DISMISSED
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}
