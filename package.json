{
  "name": "recruta-industria-web",
  "version": "0.1.1",
  "description": "Recruitment platform - v0.1.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate": "prisma migrate deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons:generate": "node scripts/generate-symbol-icons.cjs",
    "icons:generate:wordmark": "node scripts/generate-icons.cjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke-publico.spec.ts",
    "test:e2e:empresa": "playwright test e2e/empresa-logada.spec.ts e2e/empresa-perfil-vitrine.spec.ts",
    "test:e2e:profissional": "playwright test e2e/profissional-logado.spec.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "11.19.0",
    "@supabase/supabase-js": "^2.109.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "3.0.3",
    "imapflow": "^1.4.6",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "nodemailer": "10.6.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unpdf": "2.2.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.55.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "26.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "cypress": "^15.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^5.22.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "nodemailer": "10.6.0"
  }
}
