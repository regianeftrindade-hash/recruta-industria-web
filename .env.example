# =============================================================================
# PagSeguro / PagBank ? sandbox (testes)
# =============================================================================
# 1. Crie conta sandbox: https://sandbox.pagseguro.uol.com.br/
# 2. Gere o token em: https://portaldev.pagbank.com.br/tokens  (aba Tokens)
#    N?O use token de produ??o nem painel antigo do PagSeguro
# 3. Copie para .env.local e reinicie: npm run dev

PAGSEGURO_TOKEN=
PAGSEGURO_API_URL=https://sandbox.api.pagseguro.com
# URL do webhook ? PagBank exige HTTPS p?blico (n?o aceita localhost)
# Em desenvolvimento local, deixe assim; a confirma??o usa polling na tela.
# PAGSEGURO_NOTIFICATION_URL=http://localhost:3000/api/pagseguro/webhook
#
# Produ??o (exemplo com dom?nio real):
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook

# URL p?blica do app (obrigat?ria para callbacks)
NEXTAUTH_URL=http://localhost:3000

# Banco de dados
DATABASE_URL=
DIRECT_URL=

# Autentica??o (obrigat?rio em produ??o)
NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Supabase ? uploads e v?deo de apresenta??o
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (obrigat?rio em produ??o)
# ADMIN_EMAILS=admin@seudominio.com.br
# ADMIN_API_KEY=chave-longa-aleatoria

# 2FA obrigat?rio no painel admin (padr?o: ligado em produ??o)
# ENABLE_ADMIN_2FA=true
# Em desenvolvimento fica desligado; force com ENABLE_ADMIN_2FA=true

# Rate limit distribu?do (Upstash Redis) ? recomendado na Vercel
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Uploads privados (signed URL). false = URL p?blica (legado)
# UPLOADS_PRIVATE=true
# SUPABASE_UPLOADS_BUCKET=uploads

# Webhook PagBank/PagSeguro ? obrigat?rio em produ??o
# Configure a mesma chave no painel e envie no header x-webhook-secret
# PAGSEGURO_WEBHOOK_SECRET=
# PAGBANK_WEBHOOK_SECRET=

# 2FA gen?rico por e-mail (usu?rios) ? opcional
# ENABLE_2FA=false

# Atalhos do painel admin ? Servi?os (URLs dos projetos)
# ADMIN_URL_SUPABASE=https://supabase.com/dashboard/project/SEU_PROJECT_REF
# ADMIN_URL_VERCEL=https://vercel.com/seu-time/recruta-industria-web
# ADMIN_URL_GITHUB=https://github.com/seu-user/recruta-industria-web
# ADMIN_URL_GOOGLE=https://console.cloud.google.com/apis/credentials?project=SEU_PROJECT
# ADMIN_URL_BANCOS=https://minhaconta.pagbank.com.br/

# Conta empresa de teste com tudo liberado (e-mail, slug ou raz?o social, separados por v?rgula)
# COMPANY_TEST_BYPASS_KEYS=paizaonacozinha

# =============================================================================
# E-mail SMTP Hostinger (SSL/TLS) ? verifica??o, contato empresa ? Recruta
# =============================================================================
# Painel Hostinger ? E-mails ? conta (ex.: contato@recrutaindustria.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@recrutaindustria.com
SMTP_PASS=
SMTP_FROM="Recruta Ind?stria <contato@recrutaindustria.com>"

# Destino das mensagens enviadas por empresas pagas (caixa de contato do painel).
SUPPORT_EMAIL=contato@recrutaindustria.com

# Caixa de e-mail no painel admin (IMAP Hostinger).
# Mesma conta do SMTP; se IMAP_PASS estiver vazio, reutiliza SMTP_PASS.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=contato@recrutaindustria.com
IMAP_PASS=
# Se IMAP_* n?o estiver definido, tenta reutilizar SMTP_USER/SMTP_PASS
# (e mapeia smtp.hostinger.com ? imap.hostinger.com).

# PagSeguro sandbox: e-mail do comprador nos testes (opcional)
# Use um e-mail DIFERENTE do da conta PagBank se o +pagbank autom?tico n?o resolver
# PAGSEGURO_BUYER_EMAIL=comprador.teste@email.com

# =============================================================================
# PagSeguro / PagBank ? produ??o
# =============================================================================
# PAGSEGURO_TOKEN=           # token de PRODU??O (painel PagBank)
# PAGSEGURO_API_URL=https://api.pagseguro.com
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook
# NEXTAUTH_URL=https://seu-dominio.com.br
# PAGSEGURO_BUYER_EMAIL=     # opcional: s? sandbox, se +pagbank n?o resolver

# =============================================================================
# Produ??o (quando for ao ar)
# =============================================================================
# PAGSEGURO_API_URL=https://api.pagseguro.com
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook
# NEXTAUTH_URL=https://seu-dominio.com.br

# Aliases opcionais (compatibilidade)
# PAGBANK_TOKEN=
# PAGBANK_API_URL=https://sandbox.api.pagseguro.com

# =============================================================================
# Planos empresa (valores em lib/company-premium-plans.ts)
# =============================================================================
# FREE      ? R$ 0
# BASIC     ? R$ 197/m?s
# PREMIUM   ? R$ 397/m?s
# EMPRESARIAL ? R$ 997/m?s

# =============================================================================
# IA (OpenAI) ? prepara??o (desativada por padr?o)
# =============================================================================
# OPENAI_API_KEY: somente servidor (nunca NEXT_PUBLIC_).
# NEXT_PUBLIC_ENABLE_AI=false ? UI/API amig?veis/ocultas.
# Plano empresa: Company.planTier existente (n?o criar outro campo/tabela).
# FREE/BASIC: sem IA avan?ada. PREMIUM/EMPRESARIAL: recursos avan?ados (stubs).
# Profissional: POST /api/ai/professional/improve-presentation (20/m?s).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_PREMIUM=false
NEXT_PUBLIC_ENABLE_CHAT=false

# =============================================================================
# WhatsApp Business Platform / Cloud API ? prepara��o (SEM envio real)
# =============================================================================
# Nunca use NEXT_PUBLIC_ para tokens. WHATSAPP_ENABLED=false = provedor simulado.
# Telefone: reutiliza Profile.whatsapp/phone ou Company.telefone.
# Consentimento expl�cito em user_notification_preferences (n�o basta ter n�mero).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Opcional (assinatura do webhook): WHATSAPP_APP_SECRET=
# Opcional: WHATSAPP_API_VERSION=v21.0

# Pagamentos adicionais (opcional / futuro)
PAGBANK_TOKEN=

# =============================================================================
# Asaas — gateway de pagamento (Pix / Boleto)
# =============================================================================
# 1. Crie conta sandbox: https://sandbox.asaas.com
# 2. Gere a API Key em: Integrações > API
# 3. Defina PAYMENT_PROVIDER=asaas para usar o Asaas em vez do PagBank
# 4. Em produção: ASAAS_API_URL=https://api.asaas.com

PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com
# Webhook (produção — URL pública HTTPS):
# ASAAS_WEBHOOK_URL=https://seu-dominio.com.br/api/asaas/webhook
# Token enviado no header asaas-access-token (configure no painel Asaas):
# ASAAS_WEBHOOK_TOKEN=
