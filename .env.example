# =============================================================================
# PagSeguro / PagBank — sandbox (testes)
# =============================================================================
# 1. Crie conta sandbox: https://sandbox.pagseguro.uol.com.br/
# 2. Gere o token em: https://portaldev.pagbank.com.br/tokens  (aba Tokens)
#    NÃO use token de produção nem painel antigo do PagSeguro
# 3. Copie para .env.local e reinicie: npm run dev

PAGSEGURO_TOKEN=
PAGSEGURO_API_URL=https://sandbox.api.pagseguro.com
# URL do webhook — PagBank exige HTTPS público (não aceita localhost)
# Em desenvolvimento local, deixe assim; a confirmação usa polling na tela.
# PAGSEGURO_NOTIFICATION_URL=http://localhost:3000/api/pagseguro/webhook
#
# Produção (exemplo com domínio real):
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook

# URL pública do app (obrigatória para callbacks)
NEXTAUTH_URL=http://localhost:3000

# Banco de dados
DATABASE_URL=
DIRECT_URL=

# Autenticação (obrigatório em produção)
NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Supabase — uploads e vídeo de apresentação
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (opcional)
# ADMIN_EMAILS=admin@seudominio.com.br
# ADMIN_API_KEY=

# =============================================================================
# E-mail (verificação de conta, notificações)
# =============================================================================
# Obrigatório em produção para envio do código de verificação.
# Sem SMTP, o código só é logado no console em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Recruta Indústria <noreply@seudominio.com.br>"

# PagSeguro sandbox: e-mail do comprador nos testes (opcional)
# Use um e-mail DIFERENTE do da conta PagBank se o +pagbank automático não resolver
# PAGSEGURO_BUYER_EMAIL=comprador.teste@email.com

# =============================================================================
# PagSeguro / PagBank — produção
# =============================================================================
# PAGSEGURO_TOKEN=           # token de PRODUÇÃO (painel PagBank)
# PAGSEGURO_API_URL=https://api.pagseguro.com
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook
# NEXTAUTH_URL=https://seu-dominio.com.br
# PAGSEGURO_BUYER_EMAIL=     # opcional: só sandbox, se +pagbank não resolver

# =============================================================================
# Produção (quando for ao ar)
# =============================================================================
# PAGSEGURO_API_URL=https://api.pagseguro.com
# PAGSEGURO_NOTIFICATION_URL=https://seu-dominio.com.br/api/pagseguro/webhook
# NEXTAUTH_URL=https://seu-dominio.com.br

# Aliases opcionais (compatibilidade)
# PAGBANK_TOKEN=
# PAGBANK_API_URL=https://sandbox.api.pagseguro.com

# =============================================================================
# Planos empresa (valores em lib/company-premium-plans.ts)
# =============================================================================
# FREE      — R$ 0
# BASIC     — R$ 197/mês
# PREMIUM   — R$ 397/mês
# EMPRESARIAL — R$ 997/mês
