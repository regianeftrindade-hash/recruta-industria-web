# =============================================================================
# IA (OpenAI) — preparação (desativada por padrão)
# =============================================================================
# OPENAI_API_KEY: somente servidor (nunca NEXT_PUBLIC_).
# NEXT_PUBLIC_ENABLE_AI=false — UI/API amigáveis/ocultas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_PREMIUM=false
NEXT_PUBLIC_ENABLE_CHAT=false

# =============================================================================
# WhatsApp Business Platform / Cloud API — preparação (SEM envio real)
# =============================================================================
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Pagamentos adicionais (opcional / futuro)
PAGBANK_TOKEN=

# =============================================================================
# Asaas — gateway de pagamento (Pix / Boleto) — BRASIL exclusivo
# =============================================================================
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com
# ASAAS_WEBHOOK_URL=https://www.recrutaindustria.com/api/asaas/webhook
# ASAAS_WEBHOOK_TOKEN=

# =============================================================================
# Stripe — pagamentos INTERNACIONAIS (país de faturamento ≠ BR)
# Brasil continua exclusivamente no Asaas (BRL).
# Moeda de referência dos produtos Stripe: USD.
# Adaptive Pricing: localiza moeda no Checkout quando a conta Stripe suportar.
# =============================================================================
# STRIPE_SECRET_KEY=sk_live_...          # ou sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # endpoint: /api/stripe/webhook
# STRIPE_ADAPTIVE_PRICING=true           # false desativa tentativa de Adaptive Pricing

# Price IDs mensais (obrigatórios para checkout internacional de empresas)
# STRIPE_PRICE_COMPANY_BASIC_MONTHLY=price_...
# STRIPE_PRICE_COMPANY_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_COMPANY_EMPRESARIAL_MONTHLY=price_...
# STRIPE_PRICE_PROFESSIONAL_PREMIUM_MONTHLY=price_...   # plano oculto

# Price IDs anuais (opcionais; 10× mensal = 2 meses grátis)
# Referência comercial: Basic 49/490, Premium 99/990, Empresarial 199/1990, Pro 4.99/49.90 USD
# STRIPE_PRICE_COMPANY_BASIC_YEARLY=price_...
# STRIPE_PRICE_COMPANY_PREMIUM_YEARLY=price_...
# STRIPE_PRICE_COMPANY_EMPRESARIAL_YEARLY=price_...
# STRIPE_PRICE_PROFESSIONAL_PREMIUM_YEARLY=price_...

# =============================================================================
# Sentry (opcional)
# =============================================================================
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# PROFESSIONAL_PREMIUM_ENABLED=false
